{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fortify on Demand Alert Definitions Event Logs API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Event Logs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fortify Download event logs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ams.fortify.com/api/v3/eventlogs/download"
          },
          "docs": "Downloads the last 24 hours of event log data in CSV format for the tenant."
        }
      ]
    }
  ],
  "bundled": true
}