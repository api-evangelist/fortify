            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new personal access token for the authenticated user."
        },
        {
          "info": {
            "name": "Fortify Get personal access token",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ams.fortify.com/api/v3/personal-access-tokens/:personalAccessTokenId",
            "params": [
              {
                "name": "personalAccessTokenId",
                "value": "",
