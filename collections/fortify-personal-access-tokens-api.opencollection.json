                "description": "Filter expression using Fortify on Demand filter syntax. Multiple filters can be combined."
              },
              {
                "name": "orderBy",
                "value": "",
                "type": "query",
                "description": "Field name to sort results by"
              },
              {
                "name": "orderByDirection",
                "value": "",
                "type": "query",
                "description": "Sort direction"
              }
