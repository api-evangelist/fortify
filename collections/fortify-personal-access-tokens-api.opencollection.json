        },
        {
          "info": {
            "name": "Fortify Delete personal access token",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.ams.fortify.com/api/v3/personal-access-tokens/:personalAccessTokenId",
            "params": [
              {
                "name": "personalAccessTokenId",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the personal access token"
              }
            ]
          },
