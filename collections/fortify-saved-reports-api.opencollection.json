{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fortify on Demand Alert Definitions Saved Reports API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Saved Reports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fortify List saved reports",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ams.fortify.com/savedReports",
            "params": [
              {
                "name": "start",
                "value": "",
                "type": "query",
                "description": "Starting index for pagination (0-based)"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of records to return"
              },
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Search query using Fortify search syntax (e.g., name:MyApp)"
              },
              {
                "name": "fields",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of fields to include in the response"
              }
            ]
          },
          "docs": "Retrieves a list of generated reports."
        },
        {
          "info": {
            "name": "Fortify Generate report",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.ams.fortify.com/savedReports",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Schedules a report for generation based on a report definition and parameters."
        },
        {
          "info": {
            "name": "Fortify Get saved report",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ams.fortify.com/savedReports/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the resource"
              },
              {
                "name": "fields",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of fields to include in the response"
              }
            ]
          },
          "docs": "Retrieves details for a specific saved report."
        },
        {
          "info": {
            "name": "Fortify Delete saved report",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.ams.fortify.com/savedReports/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the resource"
              }
            ]
          },
          "docs": "Deletes a saved report."
        }
      ]
    }
  ],
  "bundled": true
}