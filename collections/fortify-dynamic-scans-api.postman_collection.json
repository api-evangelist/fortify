        {
          "id": "27d85776-7201-48ea-a2ec-e014cc512f51",
          "name": "Fortify Start dynamic scan",
          "request": {
            "name": "Fortify Start dynamic scan",
            "description": {
              "content": "Initiates a dynamic scan for the specified release using the current scan setup configuration.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v3",
                "releases",
                ":releaseId",
                "dynamic-scans",
                "start-scan"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "networkName",
                  "value": "<string>",
                  "description": "Name of the Fortify on Demand Connect network to use for scanning"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "releaseId",
                  "description": "(Required) Unique identifier of the release"
                }
              ]
