              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startDate\": \"<dateTime>\",\n  \"assessmentTypeId\": \"<integer>\",\n  \"entitlementId\": \"<integer>\",\n  \"entitlementFrequencyType\": \"<string>\",\n  \"isRemediationScan\": \"<boolean>\",\n  \"isBundledAssessment\": \"<boolean>\",\n  \"parentAssessmentTypeId\": \"<integer>\",\n  \"timeZone\": \"<string>\"\n}",
              "options": {
