{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fortify on Demand Alert Definitions Jobs API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Jobs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fortify List jobs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ams.fortify.com/jobs",
            "params": [
              {
                "name": "start",
                "value": "",
                "type": "query",
                "description": "Starting index for pagination (0-based)"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of records to return"
              },
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Search query using Fortify search syntax (e.g., name:MyApp)"
              },
              {
                "name": "fields",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of fields to include in the response"
              }
            ]
          },
          "docs": "Retrieves a paginated list of processing jobs (artifact processing, report generation, etc.)."
        },
        {
          "info": {
            "name": "Fortify Get job",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ams.fortify.com/jobs/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the resource"
              },
              {
                "name": "fields",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of fields to include in the response"
              }
            ]
          },
          "docs": "Retrieves details for a specific processing job."
        }
      ]
    }
  ],
  "bundled": true
}