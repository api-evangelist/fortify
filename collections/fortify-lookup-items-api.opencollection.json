{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fortify on Demand Alert Definitions Lookup Items API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Lookup Items",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fortify List lookup items",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ams.fortify.com/api/v3/lookup-items",
            "params": [
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "The type of lookup items to retrieve"
              }
            ]
          },
          "docs": "Returns a list of lookup items for the specified type, providing reference data such as scan types, time zones, and status values."
        }
      ]
    }
  ],
  "bundled": true
}