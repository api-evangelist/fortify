            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ams.fortify.com/api/v3/releases/:releaseId/scans/:scanId",
            "params": [
              {
                "name": "releaseId",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the release"
              },
              {
                "name": "scanId",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the scan"
              }
            ]
