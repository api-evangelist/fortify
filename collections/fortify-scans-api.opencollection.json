          "docs": "Returns summary information for the specified scan."
        },
        {
          "info": {
            "name": "Fortify Get scan polling summary",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ams.fortify.com/api/v3/releases/:releaseId/scans/:scanId/polling-summary",
            "params": [
              {
                "name": "releaseId",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the release"
