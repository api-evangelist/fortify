            "name": "Fortify List sensor pools",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ams.fortify.com/sensor-pools",
            "params": [
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of records to skip for pagination"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of records to return"
              }
            ]
          },
          "docs": "Retrieves a list of sensor pools used to group sensors for scan distribution."
        },
        {
          "info": {
            "name": "Fortify Create sensor pool",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.ams.fortify.com/sensor-pools",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new sensor pool for organizing sensors."
        },
        {
          "info": {
            "name": "Fortify Get sensor pool",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ams.fortify.com/sensor-pools/:sensorPoolId",
            "params": [
              {
                "name": "sensorPoolId",
                "value": "",
