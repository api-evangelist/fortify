{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fortify on Demand Alert Definitions Sensor Pools API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Sensor Pools",
