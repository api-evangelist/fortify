              }
            ]
          },
          "docs": "Retrieves details for a specific sensor pool."
        },
        {
          "info": {
            "name": "Fortify Update sensor pool",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.ams.fortify.com/sensor-pools/:sensorPoolId",
            "params": [
              {
                "name": "sensorPoolId",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the sensor pool"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates a sensor pool's properties."
        },
        {
          "info": {
            "name": "Fortify Delete sensor pool",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.ams.fortify.com/sensor-pools/:sensorPoolId",
            "params": [
              {
                "name": "sensorPoolId",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the sensor pool"
              }
            ]
          },
